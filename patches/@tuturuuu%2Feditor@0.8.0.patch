+        nextIndex: cursor,
+        node: {
+            content: [
+                {
+                    content: parseSummaryInline(summaryMatch[1] ?? '', parseInline),
+                    type: 'collapsibleSummary',
+                },
+                ...(bodyContent.length ? bodyContent : [paragraph('')]),
